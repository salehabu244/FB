# ---------------------------------------------------------------------------
# Wrapped In Word — environment variables (placeholders only, never real keys)
# Copy this file to `.env` for local development:  cp .env.example .env
# Set the real values in the Netlify UI:  Site settings → Environment variables
# ---------------------------------------------------------------------------

# --- Frontend (public, safe to expose in the browser) ----------------------
VITE_SITE_URL=https://wrappedinword.netlify.app/

# Facebook Pixel ID (optional — conversion tracking, leave empty to disable)
VITE_FACEBOOK_PIXEL_ID=

# --- Admin access ----------------------------------------------------------
# Password used to sign in to /admin. If unset, the documented default is used
# and can be changed later from inside the admin dashboard.
ADMIN_PASSWORD=admin123

# --- Email notifications (Resend) ------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="Wrapped In Word <orders@wrappedinword.netlify.app>"
BUSINESS_EMAIL=fazlamijotosob@gmail.com

# --- WhatsApp Business Cloud API (optional) --------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# "template" = official pre-approved message template (required for production)
# "text"     = plain text (only works inside an open 24h customer window)
WHATSAPP_MODE=template
# Name of the approved utility template that starts with {{1}} = order id
WHATSAPP_TEMPLATE_NAME=new_bouquet_order
